<Window x:Class="PDBViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf"
        Title="PDB Editor - Wizualizacja 3D" Height="720" Width="1080">

    <DockPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8" Background="#F0F0F0">
            <Button x:Name="OpenButton" Content="Otwórz plik PDB..." Padding="8,4" Click="OpenButton_Click"/>
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Margin="16,0,0,0"
                       Text="Brak wczytanej struktury"/>

            <TextBlock Text="Styl:" VerticalAlignment="Center" Margin="24,0,4,0"/>
            <ComboBox x:Name="StyleCombo" Width="140" SelectedIndex="0"
                      SelectionChanged="StyleCombo_SelectionChanged">
                <ComboBoxItem Content="Ball and Stick"/>
                <ComboBoxItem Content="Tylko atomy"/>
                <ComboBoxItem Content="Szkielet (cienki)"/>
            </ComboBox>
        </StackPanel>

        <h:HelixViewport3D x:Name="Viewport" DockPanel.Dock="Bottom"
                            ZoomExtentsWhenLoaded="True"
                            ShowCoordinateSystem="True"
                            ShowViewCube="True">
            <h:HelixViewport3D.DefaultCamera>
                <PerspectiveCamera Position="0,0,50" LookDirection="0,0,-1" UpDirection="0,1,0"/>
            </h:HelixViewport3D.DefaultCamera>

            <h:SunLight/>

            <ModelVisual3D x:Name="ProteinModelVisual"/>

        </h:HelixViewport3D>

    </DockPanel>
</Window>
